[Unit]
Description=Read-only Google budget collection
Wants=network-online.target
After=network-online.target
OnSuccess=finance-budget-publish.service
OnFailure=finance-budget-publish.service

[Service]
Type=oneshot
User=financebudget
Group=financebudget
WorkingDirectory=/opt/finance-budget-sync
ExecStart=/usr/bin/node /opt/finance-budget-sync/server-budget/collect.js
LoadCredentialEncrypted=google-budget:/etc/credstore.encrypted/finance-budget-google
StateDirectory=finance-budget-sync
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
InaccessiblePaths=/opt/finance-dashboard /opt/finance-bank-sync /var/lib/finance-bank-sync
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
MemoryMax=256M
TimeoutStartSec=110

